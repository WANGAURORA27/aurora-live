# ============ LiveBridge 同声传译 · 服务端配置（全部可选） ============
# 浏览器界面「设置」里也可以逐项覆盖这些配置（仅保存在本地浏览器 localStorage）。

# 监听端口
PORT=8787

# OpenAI 兼容服务地址（支持 OpenAI / DeepSeek / 硅基流动 / Groq / Moonshot / MiniMax 等，
# 只要提供 /chat/completions 即可；OpenAI 全栈还提供语音识别与语音合成）
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-xxxxxxxxxxxxxxxx

# 翻译用对话模型
CHAT_MODEL=gpt-4o-mini

# 语音识别模型（OpenAI 兼容 /v1/audio/transcriptions，如 whisper-1、groq 的 whisper-large-v3）
STT_MODEL=whisper-1

# 语音合成（OpenAI 兼容 /v1/audio/speech）。
# 注意：DeepSeek / Groq 等对话服务没有 TTS 接口 —— 没有可用云端 TTS 时，
# 前端会自动回退到浏览器本地语音合成（Web Speech API），无需配置。
TTS_MODEL=tts-1
TTS_VOICE=nova

# 开发演示模式：MOCK=1 时翻译返回模拟文本、语音返回提示音，全程不出网，
# 便于先跑通整个「录音→识别→翻译→播报」链路。
MOCK=0
