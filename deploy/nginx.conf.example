# Nginx 反代示例：放到 /etc/nginx/conf.d/livebridge.conf
# 证书用 certbot 自动签发（certbot --nginx -d 你的域名）
server {
    listen 80;
    server_name tongchuan.example.com;   # ← 改成你的域名
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name tongchuan.example.com;   # ← 改成你的域名

    ssl_certificate     /etc/letsencrypt/live/tongchuan.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tongchuan.example.com/privkey.pem;

    # SSE 长连接必需：关缓冲、放宽超时
    proxy_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}